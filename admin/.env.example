# Définir les valeurs dans l'environnement local. Ne jamais commiter les valeurs réelles.
DAYONE_ADMIN_PASSWORD=replace-with-a-long-local-password
# Facultatif : rôle relecteur, mot de passe distinct de 16 caractères minimum.
DAYONE_REVIEWER_PASSWORD=
DAYONE_BIND_HOST=127.0.0.1
DAYONE_BIND_PORT=8765
# Facultatif : emplacement de la base locale chiffrée.
# DAYONE_RUNTIME_DIR=C:/chemin/prive/dayone
